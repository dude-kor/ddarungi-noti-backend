# Copy to .env (gitignored) and fill in. Read by BOTH `docker compose` (variable substitution)
# and `./gradlew bootRun` (spring.config.import in application.yml). Never commit real values.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=ddarungi_db
MYSQL_USER=ddarungi
MYSQL_PASSWORD=change-me

# --- RabbitMQ ---
RABBIT_USER=ddarungi
RABBIT_PASSWORD=change-me

# --- Redis (empty = no AUTH) ---
REDIS_PASSWORD=

# --- Seoul Open API ---
# Local WireMock: LOCAL_KEY | ERROR_KEY | SLOW_KEY | BAD_KEY | EDGE_KEY. Production: your Open Data Plaza key.
SEOUL_API_KEY=LOCAL_KEY
# SEOUL_API_BASE_URL=http://openapi.seoul.go.kr:8088

# --- FCM ---
FCM_ENABLED=false
FCM_CREDENTIALS_PATH=
